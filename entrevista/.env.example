# Copia este fichero como .env y rellena tus claves
HEYGEN_API_KEY=tu_clave_heygen_aqui
ANTHROPIC_API_KEY=tu_clave_anthropic_aqui
# Azure Speech (voz en euskera de las Personas euskaldun). Capa gratuita F0.
# KEY 1 y Location del recurso Speech (portal.azure.com → Claves y punto de conexión).
AZURE_SPEECH_KEY=tu_clave_azure_speech_aqui
AZURE_SPEECH_REGION=westeurope
PORT=3000
# Contraseña para proteger la app cuando está online (Basic Auth).
# Si se deja vacía, el acceso es libre (uso local). En Render, ponla siempre.
SITE_PASSWORD=
